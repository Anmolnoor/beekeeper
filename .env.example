# =====================================================================
# Beekeeper — example environment file
# Copy to `.env` and fill in the values you need. `.env` is gitignored.
#
# Minimum to get started:
#   1. Set ONE LLM provider (ollama is free + local; gemini/openai need keys)
#   2. Leave the Infrastructure section alone if you use the bundled
#      docker-compose; it points everything at the right defaults.
#   3. Everything below "Security" is only required when
#      BEEKEEPER_RUNTIME_MODE != dev.
# =====================================================================


# ---------------------------------------------------------------------
# LLM Providers
# ---------------------------------------------------------------------
# Comma-separated fallback chain. Earlier providers are tried first.
# Valid values: ollama, gemini, openai
BEEKEEPER_LLM_PROVIDERS=ollama,gemini,openai

# --- Ollama (local or Ollama Cloud) ---
# Local default: http://localhost:11434  (model: llama3.2)
# Ollama Cloud:  https://ollama.com      (set BEEKEEPER_OLLAMA_API_KEY)
BEEKEEPER_OLLAMA_BASE_URL=http://localhost:11434
BEEKEEPER_OLLAMA_MODEL=llama3.2
BEEKEEPER_OLLAMA_API_KEY=
BEEKEEPER_OLLAMA_TIMEOUT_SECONDS=120

# --- Google Gemini ---
BEEKEEPER_GEMINI_API_KEY=
BEEKEEPER_GEMINI_MODEL=gemini-1.5-flash
BEEKEEPER_GEMINI_TIMEOUT_SECONDS=120

# --- OpenAI ---
BEEKEEPER_OPENAI_API_KEY=
BEEKEEPER_OPENAI_MODEL=gpt-4o-mini
BEEKEEPER_OPENAI_BASE_URL=https://api.openai.com/v1
BEEKEEPER_OPENAI_TIMEOUT_SECONDS=120


# ---------------------------------------------------------------------
# Infrastructure (defaults match the bundled docker-compose)
# ---------------------------------------------------------------------
# Celery / Redis — task queue + result backend
BEEKEEPER_CELERY_BROKER_URL=redis://localhost:6379/0
BEEKEEPER_CELERY_BACKEND_URL=redis://localhost:6379/1
BEEKEEPER_SCHEDULER_BACKEND=celery

# Vector store (Qdrant)
BEEKEEPER_VECTOR_BACKEND=qdrant
BEEKEEPER_VECTOR_URL=http://localhost:6333
BEEKEEPER_VECTOR_COLLECTION=beekeeper

# Temporal (workflow engine — optional for basic usage)
BEEKEEPER_TEMPORAL_ENDPOINT=localhost:7233
BEEKEEPER_TEMPORAL_ENDPOINT_FALLBACKS=temporal:7233,localhost:7233,host.docker.internal:7233
BEEKEEPER_TEMPORAL_NAMESPACE=default
BEEKEEPER_TEMPORAL_TASK_QUEUE=beekeeper-queue

# SearXNG (search) — split URLs prevent localhost leakage inside containers.
# `_LOCAL` is used when running on host; `_DOCKER` when running in a container.
BEEKEEPER_SEARXNG_BASE_URL_LOCAL=http://localhost:8080
BEEKEEPER_SEARXNG_BASE_URL_DOCKER=http://searxng:8080

# Force runtime context detection (auto-detected via /.dockerenv otherwise).
# BEEKEEPER_RUNTIME_CONTEXT=local


# ---------------------------------------------------------------------
# Storage paths
# ---------------------------------------------------------------------
# Where artifacts, traces, and audit logs live on disk.
BEEKEEPER_STORE_ROOT=.beekeeper_store
BEEKEEPER_HONEYCOMB_ROOT=.honeycomb
# BEEKEEPER_ARTIFACT_BACKEND=local
# BEEKEEPER_OBJECT_STORAGE_DEV_ROOT=.beekeeper_store/objects


# ---------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------
# BEEKEEPER_PORT=8787
# BEEKEEPER_BASE_URL=http://localhost:8787


# ---------------------------------------------------------------------
# Runtime mode & security
# ---------------------------------------------------------------------
# dev      — sensible defaults, no required secrets (use this to start)
# internal — fail-closed on missing security config
# prod     — same as internal, plus stricter policy gates
BEEKEEPER_RUNTIME_MODE=dev

# Used to sign audit log entries. Generate a random string for non-dev runs.
BEEKEEPER_AUDIT_SIGNING_KEY=beekeeper-dev-signing-key

# Required when BEEKEEPER_RUNTIME_MODE != dev:
# BEEKEEPER_JWT_SECRET=
# BEEKEEPER_CHANNEL_SECRET_KEY=
# BEEKEEPER_DATABASE_BACKEND=postgres
# BEEKEEPER_DATABASE_DSN=postgresql://user:pass@host:5432/beekeeper
# BEEKEEPER_OBJECT_STORAGE_ENDPOINT=
# BEEKEEPER_OBJECT_STORAGE_BUCKET=
# BEEKEEPER_SECRET_MANAGER_PROVIDER=vault   # vault|aws|gcp|azure
# BEEKEEPER_VAULT_ADDR=
# BEEKEEPER_VAULT_TOKEN=
# BEEKEEPER_REPLAY_PROTECTION_WINDOW_SECONDS=600
# BEEKEEPER_TENANT_SECRET_SCOPING=required
# BEEKEEPER_TOOL_CREDENTIAL_BOUNDARY=enforced


# ---------------------------------------------------------------------
# Channels (optional — only set what you use)
# ---------------------------------------------------------------------
# --- Slack ---
# BEEKEEPER_SLACK_CLIENT_ID=
# BEEKEEPER_SLACK_CLIENT_SECRET=

# --- WhatsApp (Meta Cloud API) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=


# ---------------------------------------------------------------------
# MCP servers (optional — external tool servers)
# ---------------------------------------------------------------------
# Single stdio server:
#   BEEKEEPER_MCP_SERVERS=stdio:npx:-y:@modelcontextprotocol/server-filesystem
# Single HTTP server:
#   BEEKEEPER_MCP_SERVERS=http:https://example.com/mcp
# Multiple servers (JSON):
#   BEEKEEPER_MCP_SERVERS_JSON=[{"transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem"]}]
# BEEKEEPER_MCP_SERVERS=
# BEEKEEPER_MCP_SERVERS_JSON=


# ---------------------------------------------------------------------
# Advanced / tuning (defaults are fine for most users)
# ---------------------------------------------------------------------
# BEEKEEPER_AUDIT_ENABLED=true
# BEEKEEPER_AUDIT_SYNC_WRITE=false
# BEEKEEPER_AUDIT_QUEUE_MAXSIZE=10000
# BEEKEEPER_AUDIT_QUEUE_TIMEOUT_SECONDS=1.0
# BEEKEEPER_AUDIT_MAX_RETRIES=3
# BEEKEEPER_AUDIT_RETRY_BASE_MS=100
# BEEKEEPER_EXECUTION_MODE=local
# BEEKEEPER_POLICY_ENDPOINT=
